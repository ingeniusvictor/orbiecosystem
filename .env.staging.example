# ORBI News staging — placeholders only. Never commit real secret values.
NODE_ENV=production
ORBI_NEWS_ACTIVATION_PROFILE=DISABLED
ORBI_NEWS_RUNTIME_ENABLED=false
ORBI_NEWS_ORGANIZATION_ID=orbi-ecosystem-staging
ORBI_NEWS_WORKER_ID=vercel-staging
ORBI_NEWS_SYSTEM_MODE=MAINTENANCE
ORBI_NEWS_AUTONOMY_LEVEL=LEVEL_0
ORBI_NEWS_LEASE_DURATION_SECONDS=300
ORBI_NEWS_MAX_ATTEMPTS=3
ORBI_EDITORIAL_FIRESTORE_ENABLED=true
ORBI_EDITORIAL_FIRESTORE_PROJECT_ID=<staging-gcp-project-id>
ORBI_EDITORIAL_FIRESTORE_DATABASE_ID=<optional-database-id>
ORBI_NEWS_ENABLED_TOGGLES=
ORBI_NEWS_AVAILABLE_CAPABILITIES=
ORBI_NEWS_ACTIVE_KILL_SWITCHES=
ORBI_NEWS_WEB_DAILY_LIMIT=2
ORBI_NEWS_WEB_DAILY_USED=0
ORBI_NEWS_SOURCE_REGISTRY_JSON=<validated-json-array>
ORBI_NEWS_LIVE_PROCESSING_LIMIT=2
ORBI_NEWS_GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=<vercel-secret>
CRON_SECRET=<vercel-secret-min-32-chars>
ORBI_PUBLIC_BASE_URL=<https-staging-url>
RESEND_API_KEY=<vercel-secret>
ORBI_NEWS_EMAIL_FROM=<verified-staging-sender>
ORBI_NEWS_DIGEST_RECIPIENT=<owner-email>
