FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build:orbi-news-runtime

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist/orbi-news-runtime.cjs ./dist/orbi-news-runtime.cjs
USER node
EXPOSE 8080
CMD ["node", "dist/orbi-news-runtime.cjs"]
